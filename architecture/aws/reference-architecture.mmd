flowchart TB
    U[Customers / Browsers] --> DNS[Route 53]
    DNS --> EDGE[CloudFront + AWS WAF]
    EDGE --> ALB[Public ALB across 3 AZs]
    subgraph VPC["VPC - Primary Region"]
      subgraph PUB["Public subnets"]
        ALB
        NAT[NAT gateways / controlled egress]
      end
      subgraph APP["Private application subnets - 3 AZs"]
        ECS[ECS Fargate or EKS workloads]
        WORK[Worker / async consumers]
      end
      subgraph DATA["Private data subnets"]
        DB[(RDS/Aurora Multi-AZ)]
        CACHE[(ElastiCache Redis)]
      end
      EP[VPC endpoints]
      SECRETS[Secrets Manager + KMS]
      LOGS[CloudWatch + CloudTrail]
      QUEUE[SQS / EventBridge]
      OBJ[S3 with versioning]
      ECS --> DB
      ECS --> CACHE
      ECS --> QUEUE
      WORK --> QUEUE
      ECS --> SECRETS
      ECS --> EP
      DB --> LOGS
      ECS --> LOGS
      WORK --> OBJ
    end
    ALB --> ECS
    DB -. cross-region backup / replica .-> DR[Recovery Region]
    OBJ -. replication / backup policy .-> DR
